# Skopiuj do .env.local i uzupełnij (poproś właściciela). Oba klucze są PUBLICZNE (trafiają do bundla).
# Sekrety serwerowe (Stripe sk_, Supabase service_role) NIE należą do tego repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Projekt Supabase MySunrise — Market loguje tam kliknięcia w linki polecające
# (RPC mme_log_ref_click) WPROST Z PRZEGLĄDARKI, żeby funkcja widziała prawdziwe
# nagłówki gościa (user-agent, IP, kraj). Wołana przez most serwerowy oznaczałaby
# każde kliknięcie jako podejrzane. Klucz anon jest PUBLICZNY, jak powyższe.
VITE_MYSUNRISE_URL=
VITE_MYSUNRISE_ANON_KEY=
